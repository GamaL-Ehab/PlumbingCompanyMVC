@model ContactAddVM
@{
    ViewData["Title"] = "AddContact";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h5 class="card-title fs-1">Add New Contact Us</h5>

<nav>
	<ol class="breadcrumb">
		<li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
		<li class="breadcrumb-item"><a asp-action="Index">Contact</a></li>
		<li class="breadcrumb-item active">Add</li>
	</ol>
</nav>

<div class="card p-2 pt-4">
	<div class="card-body">
		<!-- Floating Labels Form -->
		<form asp-controller="Contact" asp-action="AddContact" method="post" class="row g-3">

			<div class="col-md-12">
				<div class="form-floating">
					<input asp-for="Location" type="text" class="form-control" placeholder="Location">
					<label asp-for="Location">Location</label>
				</div>
			</div>
			<div class="col-md-6">
				<div class="form-floating">
					<input asp-for="Email" type="email" class="form-control" placeholder="Email">
					<label asp-for="Email">Email</label>
				</div>
			</div>
			<div class="col-md-6">
				<div class="form-floating">
					<input asp-for="Call" type="text" class="form-control" placeholder="Call">
					<label asp-for="Call">Call</label>
				</div>
			</div>
			<div class="col-md-12">
				<div class="form-floating">
					<input asp-for="Map" type="text" class="form-control" placeholder="Map">
					<label asp-for="Map">Map</label>
				</div>
			</div>

			<div class="text-end">
				<button type="reset" class="btn btn-secondary">Reset</button>
				<button type="submit" class="btn btn-primary">Submit</button>
			</div>
		</form><!-- End floating Labels Form -->
	</div>
</div>

