@model List<ContactListVM>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-flex flex-wrap justify-content-between align-items-center">
	<h5 class="card-title fs-1">Contact Us</h5>
	<a asp-controller="Contact" asp-action="AddContact" class="btn btn-primary">Add +</a>
</div>

<nav>
	<ol class="breadcrumb">
		<li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
		<li class="breadcrumb-item active">Contact Us</li>
	</ol>
</nav>

<div class="card">
	<div class="card-body">
		<!-- Table with hoverable rows -->
		<table class="table table-hover">
			<thead>
				<tr>
					<th scope="col">Location</th>
					<th scope="col">Email</th>
					<th scope="col">Call</th>
					<th scope="col">Map</th>
					<th scope="col">Created Date</th>
					<th scope="col">Updated Date</th>
					<th scope="col">Edit</th>
					<th scope="col">Delete</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var contact in Model)
				{
					<tr>
						<td>@contact.Location</td>
						<td>@contact.Email</td>
						<td>@contact.Call</td>
						@if (contact.Map is not null)
						{
							<td><span class="badge bg-success">Assigned</span></td>
						}
						else
						{
							<td><span class="badge bg-secondary">Not Assigned</span></td>
						}
						<td>@contact.CreatedDate</td>
						<td>@contact.UpdatedDate</td>
						<td><a asp-controller="Contact" asp-action="UpdateContact" asp-route-id="@contact.Id" data-id="@contact.Id" class="btn btn-warning btn-sm text-white">Edit</a></td>
						<td><a asp-controller="Contact" asp-action="DeleteContact" asp-route-id="@contact.Id" data-id="@contact.Id" class="btn btn-danger btn-sm">Delete</a></td>
					</tr>
				}
			</tbody>
		</table>
		<!-- End Table with hoverable rows -->

	</div>
</div>

