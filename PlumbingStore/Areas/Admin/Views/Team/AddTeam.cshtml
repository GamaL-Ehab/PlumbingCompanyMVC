@model TeamAddVM
@{
    ViewData["Title"] = "AddTeam";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h5 class="card-title fs-1">Add New Team Member</h5>

<nav>
	<ol class="breadcrumb">
		<li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
		<li class="breadcrumb-item"><a asp-action="Index">Teams</a></li>
		<li class="breadcrumb-item active">Add</li>
	</ol>
</nav>

<div class="card p-2 pt-4">
	<div class="card-body">
		<!-- Floating Labels Form -->
		<form asp-controller="Team" asp-action="AddTeam" method="post" enctype="multipart/form-data" class="row g-3">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>

			<input hidden asp-for="FileName" type="text" value="PhotoName" />
			<input hidden asp-for="FileType" type="text" value="PhotoEx" />

			<div class="col-md-12">
				<div>
					<label asp-for="Photo">Photo</label>
					<input asp-for="Photo" type="file" accept="image/*" class="form-control" placeholder="Photo">
					<span asp-validation-for="Photo" class="text-danger"></span>
				</div>
			</div>
			<div class="col-md-6">
				<div class="form-floating">
					<input asp-for="FullName" type="text" class="form-control" placeholder="FullName">
					<label asp-for="FullName">FullName</label>
					<span asp-validation-for="FullName" class="text-danger"></span>
				</div>
			</div>
			<div class="col-md-6">
				<div class="form-floating">
					<input asp-for="Title" type="text" class="form-control" placeholder="Title">
					<label asp-for="Title">Title</label>
					<span asp-validation-for="Title" class="text-danger"></span>
				</div>
			</div>

			<h3 class="border-bottom">Social Media Links</h3>
			<div class="col-md-3">
				<div class="form-floating">
					<input asp-for="Twitter" type="text" class="form-control" placeholder="Twitter">
					<label asp-for="Twitter">Twitter</label>
					<span asp-validation-for="Twitter" class="text-danger"></span>
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-floating">
					<input asp-for="Facebook" type="text" class="form-control" placeholder="Facebook">
					<label asp-for="Facebook">Facebook</label>
					<span asp-validation-for="Facebook" class="text-danger"></span>
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-floating">
					<input asp-for="Instagram" type="text" class="form-control" placeholder="Instagram">
					<label asp-for="Instagram">Instagram</label>
					<span asp-validation-for="Instagram" class="text-danger"></span>
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-floating">
					<input asp-for="LinkedIn" type="text" class="form-control" placeholder="LinkedIn">
					<label asp-for="LinkedIn">LinkedIn</label>
					<span asp-validation-for="LinkedIn" class="text-danger"></span>
				</div>
			</div>

			<div class="text-end">
				<button type="reset" class="btn btn-secondary">Reset</button>
				<button type="submit" class="btn btn-primary">Submit</button>
			</div>
		</form><!-- End floating Labels Form -->
	</div>
</div>

