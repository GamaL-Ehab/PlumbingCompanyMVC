@model AboutUpdateVM
@{
    ViewData["Title"] = "UpdateAbout";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h5 class="card-title fs-1">Update About Us</h5>

<nav>
	<ol class="breadcrumb">
		<li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
		<li class="breadcrumb-item"><a asp-action="Index">About Us</a></li>
		<li class="breadcrumb-item active">Update</li>
	</ol>
</nav>

<div class="card p-2 pt-4">
	<div class="card-body">
		<!-- Floating Labels Form -->
		<form asp-controller="About" asp-action="UpdateAbout" method="post" enctype="multipart/form-data" class="row g-3">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>

			<input hidden asp-for="Id" type="hidden"/>
			<input hidden asp-for="RowVersion" type="hidden" />
			<input hidden asp-for="FileName" type="text" value="PhotoName" />
			<input hidden asp-for="FileType" type="text" value="PhotoEx" />

			<div class="col-md-12">
				<div>
					<label asp-for="Photo">Photo</label>
					<input asp-for="Photo" type="file" accept="image/*" class="form-control" placeholder="Photo">
					<span asp-validation-for="Photo" class="text-danger"></span>
				</div>
			</div>
			<div class="col-md-12">
				<div class="form-floating">
					<input asp-for="Header" type="text" class="form-control" placeholder="Header">
					<label asp-for="Header">Header</label>
					<span asp-validation-for="Header" class="text-danger"></span>
				</div>
			</div>
			<div class="col-md-12">
				<div class="form-floating">
					<textarea asp-for="Description" type="text" class="form-control" style="min-height:100px;" placeholder="Description"></textarea>
					<label asp-for="Description">Description</label>
					<span asp-validation-for="Description" class="text-danger"></span>
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-floating">
					<input asp-for="Clients" type="number" class="form-control" placeholder="Clients">
					<label asp-for="Clients">Clients</label>
					<span asp-validation-for="Clients" class="text-danger"></span>
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-floating">
					<input asp-for="Projects" type="number" class="form-control" placeholder="Projects">
					<label asp-for="Projects">Projects</label>
					<span asp-validation-for="Projects" class="text-danger"></span>
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-floating">
					<input asp-for="HardWorkers" type="number" class="form-control" placeholder="Hard Workers">
					<label asp-for="HardWorkers">Hard Workers</label>
					<span asp-validation-for="HardWorkers" class="text-danger"></span>
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-floating">
					<input asp-for="HoursOfSupport" type="number" class="form-control" placeholder="Hours Of Support">
					<label asp-for="HoursOfSupport">Hours Of Support</label>
					<span asp-validation-for="HoursOfSupport" class="text-danger"></span>
				</div>
			</div>

			<h3 class="border-bottom">Social Media Links</h3>
			<div class="col-md-3">
				<div class="form-floating">
					<input asp-for="SocialMedia.Twitter" type="text" class="form-control" placeholder="Twitter">
					<label asp-for="SocialMedia.Twitter">Twitter</label>
					<span asp-validation-for="SocialMedia.Twitter" class="text-danger"></span>
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-floating">
					<input asp-for="SocialMedia.Facebook" type="text" class="form-control" placeholder="Facebook">
					<label asp-for="SocialMedia.Facebook">Facebook</label>
					<span asp-validation-for="SocialMedia.Facebook" class="text-danger"></span>
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-floating">
					<input asp-for="SocialMedia.Instagram" type="text" class="form-control" placeholder="Instagram">
					<label asp-for="SocialMedia.Instagram">Instagram</label>
					<span asp-validation-for="SocialMedia.Instagram" class="text-danger"></span>
				</div>
			</div>
			<div class="col-md-3">
				<div class="form-floating">
					<input asp-for="SocialMedia.LinkedIn" type="text" class="form-control" placeholder="LinkedIn">
					<label asp-for="SocialMedia.LinkedIn">LinkedIn</label>
					<span asp-validation-for="SocialMedia.LinkedIn" class="text-danger"></span>
				</div>
			</div>

			<div class="text-end">
				<button type="reset" class="btn btn-secondary">Reset</button>
				<button type="submit" class="btn btn-primary">Submit</button>
			</div>
		</form><!-- End floating Labels Form -->
	</div>
</div>


