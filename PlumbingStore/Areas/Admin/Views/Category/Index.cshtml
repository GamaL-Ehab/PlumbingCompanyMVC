@model List<CategoryListVM>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-flex flex-wrap justify-content-between align-items-center">
	<h5 class="card-title fs-1">Categories</h5>
	<a asp-controller="Category" asp-action="AddCategory" class="btn btn-primary">Add +</a>
</div>

<nav>
	<ol class="breadcrumb">
		<li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
		<li class="breadcrumb-item active">Categories</li>
	</ol>	
</nav>

<div class="card">
	<div class="card-body">
		<!-- Table with hoverable rows -->
		<table class="table table-hover">
			<thead>
				<tr>
					<th scope="col">Name</th>
					<th scope="col">Created Date</th>
					<th scope="col">Updated Date</th>
					<th scope="col">Edit</th>
					<th scope="col">Delete</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var category in Model)
				{
					<tr>
						<td>@category.Name</td>
						<td>@category.CreatedDate</td>
						<td>@category.UpdatedDate</td>
						<td><a asp-controller="Category" asp-action="UpdateCategory" asp-route-id="@category.Id" data-id="@category.Id" class="btn btn-warning btn-sm text-white">Edit</a></td>
						<td><a asp-controller="Category" asp-action="DeleteCategory" asp-route-id="@category.Id" data-id="@category.Id" class="btn btn-danger btn-sm">Delete</a></td>
					</tr>
				}
			</tbody>
		</table>
		<!-- End Table with hoverable rows -->

	</div>
</div>

