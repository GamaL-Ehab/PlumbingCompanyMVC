@model List<PortfolioListVM>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-flex flex-wrap justify-content-between align-items-center">
	<h5 class="card-title fs-1">Portfolios</h5>
	<a asp-controller="Portfolio" asp-action="AddPortfolio" class="btn btn-primary">Add +</a>
</div>

<nav>
	<ol class="breadcrumb">
		<li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
		<li class="breadcrumb-item active">Portfolios</li>
	</ol>
</nav>

<div class="card">
	<div class="card-body">
		<!-- Table with hoverable rows -->
		<table class="table table-hover">
			<thead>
				<tr>
					<th scope="col">Title</th>
					<th scope="col">Category</th>
					<th scope="col">Created Date</th>
					<th scope="col">Updated Date</th>
					<th scope="col">Edit</th>
					<th scope="col">Delete</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var portfolio in Model)
				{
					<tr>
						<td>@portfolio.Title</td>
						<td>@portfolio.Category.Name</td>
						<td>@portfolio.CreatedDate</td>
						<td>@portfolio.UpdatedDate</td>
						<td><a asp-controller="Portfolio" asp-action="UpdatePortfolio" asp-route-id="@portfolio.Id" data-id="@portfolio.Id" class="btn btn-warning btn-sm text-white">Edit</a></td>
						<td><a asp-controller="Portfolio" asp-action="DeletePortfolio" asp-route-id="@portfolio.Id" data-id="@portfolio.Id" class="btn btn-danger btn-sm">Delete</a></td>
					</tr>
				}
			</tbody>
		</table>
		<!-- End Table with hoverable rows -->

	</div>
</div>

