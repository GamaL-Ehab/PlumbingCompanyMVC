@model PortfolioUpdateVM
@{
    ViewData["Title"] = "UpdatePortfolio";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h5 class="card-title fs-1">Update Portfolio</h5>

<nav>
	<ol class="breadcrumb">
		<li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
		<li class="breadcrumb-item"><a asp-action="Index">Portfolio</a></li>
		<li class="breadcrumb-item active">Update</li>
	</ol>
</nav>

<div class="card p-2 pt-4">
	<div class="card-body">
		<!-- Floating Labels Form -->
		<form asp-controller="Portfolio" asp-action="UpdatePortfolio" method="post" class="row g-3" enctype="multipart/form-data">
			<input hidden asp-for="Id" type="hidden" />
			<input hidden asp-for="RowVersion" type="hidden" />
			<input hidden asp-for="FileName" type="text" value="PhotoName" />
			<input hidden asp-for="FileType" type="text" value="PhotoEx" />

			<div class="col-md-12">
				<div>
					<label asp-for="Photo">Photo</label>
					<input asp-for="Photo" type="file" accept="image/*" class="form-control" placeholder="Photo">
				</div>
			</div>
			<div class="col-md-6">
				<div class="form-floating">
					<input asp-for="Title" type="text" class="form-control" placeholder="Title">
					<label asp-for="Title">Title</label>
				</div>
			</div>
			<div class="col-md-6">
				<div class="form-floating">
					<input asp-for="CategoryId" type="number" class="form-control" placeholder="CategoryId">
					<label asp-for="CategoryId">Category Id</label>
				</div>
			</div>

			<div class="text-end">
				<button type="reset" class="btn btn-secondary">Reset</button>
				<button type="submit" class="btn btn-primary">Submit</button>
			</div>
		</form><!-- End floating Labels Form -->
	</div>
</div>

<!-- Card with an image on top -->
<div class="card">
	<img src="~/Admin/assets/img/card.jpg" class="card-img-top" alt="@Model.Title">
</div><!-- End Card with an image on top -->
