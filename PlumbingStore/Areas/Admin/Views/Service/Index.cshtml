@model List<ServiceListVM>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-flex flex-wrap justify-content-between align-items-center">
	<h5 class="card-title fs-1">Services</h5>
	<a asp-controller="Service" asp-action="AddService" class="btn btn-primary">Add +</a>
</div>

<nav>
	<ol class="breadcrumb">
		<li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
		<li class="breadcrumb-item active">Services</li>
	</ol>
</nav>

<div class="card">
	<div class="card-body">
		<!-- Table with hoverable rows -->
		<table class="table table-hover">
			<thead>
				<tr>
					<th scope="col">Name</th>
					<th scope="col">Description</th>
					<th scope="col">Created Date</th>
					<th scope="col">Updated Date</th>
					<th scope="col">Edit</th>
					<th scope="col">Delete</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var service in Model)
				{
					<tr>
						<td>@service.Name</td>
						<td>@service.Description</td>
						<td>@service.CreatedDate</td>
						<td>@service.UpdatedDate</td>
						<td><a asp-controller="Service" asp-action="UpdateService" asp-route-id="@service.Id" data-id="@service.Id" class="btn btn-warning btn-sm text-white">Edit</a></td>
						<td><a asp-controller="Service" asp-action="DeleteService" asp-route-id="@service.Id" data-id="@service.Id" class="btn btn-danger btn-sm">Delete</a></td>
					</tr>
				}
			</tbody>
		</table>
		<!-- End Table with hoverable rows -->

	</div>
</div>

