@model HomePageAddVM
@{
    ViewData["Title"] = "AddHomePage";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h5 class="card-title fs-1">Add New Home Page</h5>

<nav>
	<ol class="breadcrumb">
		<li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
		<li class="breadcrumb-item"><a asp-action="Index">Home Page</a></li>
		<li class="breadcrumb-item active">Add</li>
	</ol>
</nav>

<div class="card p-2 pt-4">
	<div class="card-body">
		<!-- Floating Labels Form -->
		<form asp-controller="HomePage" asp-action="AddHomePage" method="post" class="row g-3">

			<div class="col-md-12">
				<div class="form-floating">
					<input asp-for="Header" type="text" class="form-control" placeholder="Header">
					<label asp-for="Header">Header</label>
				</div>
			</div>
			<div class="col-md-12">
				<div class="form-floating">
					<textarea asp-for="Description" type="text" class="form-control" placeholder="Description" style="min-height: 100px;"></textarea>
					<label asp-for="Description">Description</label>
				</div>
			</div>
			<div class="col-md-12">
				<div class="form-floating">
					<input asp-for="VideoLink" type="text" class="form-control" placeholder="VideoLink">
					<label asp-for="VideoLink">VideoLink</label>
				</div>
			</div>

			<div class="text-end">
				<button type="reset" class="btn btn-secondary">Reset</button>
				<button type="submit" class="btn btn-primary">Submit</button>
			</div>
		</form><!-- End floating Labels Form -->
	</div>
</div>

